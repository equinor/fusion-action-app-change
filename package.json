{
  "name": "fusion-action-app-change",
  "version": "0.1.0",
  "description": "GitHub Action for detecting changes in Fusion applications",
  "main": "scripts/index.js",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "biome lint scripts/",
    "format": "biome format --write scripts/",
    "check": "biome check --write scripts/",
    "build": "npm run check && npm run test",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish",
    "release": "npm run build && npm run changeset:publish"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/equinor/fusion-action-app-change.git"
  },
  "keywords": [
    "github-action",
    "fusion",
    "change-detection",
    "continuous-deployment"
  ],
  "author": "Equinor",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^1.10.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@changesets/changelog-github": "^0.5.2",
    "@changesets/cli": "^2.29.8",
    "jest": "^29.7.0"
  }
}
