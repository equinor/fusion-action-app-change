{
  "name": "fusion-action-app-change",
  "version": "0.3.0",
  "private": true,
  "description": "GitHub Action for detecting changes in Fusion applications",
  "main": "dist/index.js",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "lint": "biome lint src/ *.config.ts",
    "format": "biome format --write src/ *.config.ts",
    "check": "biome check --write src/ *.config.ts",
    "type-check": "tsc --noEmit",
    "package": "vite build",
    "build": "npm run type-check && npm run check && npm run test && npm run package",
    "changeset": "changeset",
    "changeset:version": "changeset version && pnpm install --no-frozen-lockfile && pnpm run build",
    "release": "npm run build && npm run changeset:publish"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/equinor/fusion-action-app-change.git"
  },
  "keywords": [
    "github-action",
    "fusion",
    "change-detection",
    "continuous-deployment"
  ],
  "author": "Equinor",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^2.0.2",
    "shell-quote": "^1.8.3",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.7",
    "undici": "6.23.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.11",
    "@changesets/changelog-github": "^0.5.2",
    "@changesets/cli": "^2.29.8",
    "@types/node": "^25.0.9",
    "@types/shell-quote": "^1.7.5",
    "@vitest/ui": "^4.0.17",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.17"
  },
  "pnpm": {
    "overrides": {
      "undici": ">=6.23.0"
    }
  }
}
